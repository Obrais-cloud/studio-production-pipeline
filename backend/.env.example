APP_NAME=Studio Production Pipeline API
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PREFIX=/api

# Database (SQLite for local dev, PostgreSQL for Docker)
DATABASE_URL=sqlite:///./studio.db
# DATABASE_URL=postgresql://studio:studio@localhost:5432/studio_pipeline

# YouTube Data API v3
# Download client_secret.json from Google Cloud Console and set path here
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_REFRESH_TOKEN=

# Vimeo API
VIMEO_ACCESS_TOKEN=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
